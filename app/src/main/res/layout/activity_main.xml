<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Variables e imports que se pueden usar en las expresiones @{...} -->
    <data>
        <import type="android.view.View" />
        <import type="es.davante.edadcanina.modelo.Validacion" />

        <variable
            name="modelo"
            type="es.davante.edadcanina.modelo.EdadCaninaModelo" />

        <variable
            name="controlador"
            type="es.davante.edadcanina.controlador.EdadCaninaControlador" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".MainActivity">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/txt_titulo"
            android:textSize="32sp" />

        <ImageView
            android:layout_width="192dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:src="@drawable/imgdog" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/input_age"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/age_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:gravity="center"
            android:hint="@string/hint_edad"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2"
            android:text="@={modelo.edadTexto}"
            app:errorValidacion="@{modelo.validacion}"
            android:imeOptions="actionDone"
            app:alPulsarHecho="@{() -> controlador.calcular()}"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@{@string/tu_edad_format(modelo.edadHumana)}"
            android:textSize="16sp"
            android:visibility="@{modelo.validacion == Validacion.OK ? View.VISIBLE : View.INVISIBLE}" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_calc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:onClick="@{() -> controlador.calcular()}"
                android:text="@string/btn_calc"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btn_limpiar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:onClick="@{() -> controlador.limpiar()}"
                android:text="@string/btn_limpiar"
                android:textSize="22sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>